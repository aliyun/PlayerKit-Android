<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ai_education_list_item_padding_horizontal"
    android:paddingTop="@dimen/ai_education_list_item_padding_vertical"
    android:paddingEnd="@dimen/ai_education_list_item_padding_horizontal"
    android:paddingBottom="@dimen/ai_education_list_item_padding_vertical">

    <!-- Thumbnail -->
    <ImageView
        android:id="@+id/iv_thumbnail"
        android:layout_width="@dimen/ai_education_thumbnail_width"
        android:layout_height="@dimen/ai_education_thumbnail_height"
        android:background="@drawable/bg_chapter_thumbnail"
        android:clipToOutline="true"
        android:scaleType="centerCrop" />

    <!-- Title + timestamp -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_chapter_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ai_education_text_primary_80"
            android:textSize="@dimen/ai_education_text_size_body" />

        <TextView
            android:id="@+id/tv_chapter_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ai_education_text_time"
            android:textSize="@dimen/ai_education_text_size_secondary" />

    </LinearLayout>

    <!-- Chevron -->
    <ImageView
        android:id="@+id/iv_chevron_right"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/ai_education_text_primary_80" />

</LinearLayout>
