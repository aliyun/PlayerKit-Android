<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="@dimen/seek_thumbnail_margin_bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!--  Seek 缩略图  -->
        <ImageView
            android:id="@+id/iv_seek_thumbnail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxWidth="@dimen/seek_thumbnail_max_size"
            android:maxHeight="@dimen/seek_thumbnail_max_size"
            android:minWidth="@dimen/seek_thumbnail_min_size"
            android:minHeight="@dimen/seek_thumbnail_min_size"
            android:scaleType="fitCenter" />

        <!--  时间显示  -->
        <TextView
            android:id="@+id/tv_seek_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/seek_thumbnail_time_margin_top"
            android:textColor="@android:color/white"
            android:textSize="@dimen/seek_thumbnail_text_size"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>
