<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:minHeight="@dimen/chapter_item_height"
    android:paddingStart="@dimen/chapter_item_padding_horizontal"
    android:paddingTop="@dimen/chapter_item_padding_vertical"
    android:paddingEnd="@dimen/chapter_item_padding_horizontal"
    android:paddingBottom="@dimen/chapter_item_padding_vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/chapter_thumbnail_width"
        android:layout_height="@dimen/chapter_thumbnail_height"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/iv_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chapter_chip_padding_horizontal"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_chapter_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/chapter_title_unselected"
            android:textSize="@dimen/common_text_14" />

        <TextView
            android:id="@+id/tv_chapter_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/chapter_item_time_margin_top"
            android:textColor="@color/chapter_secondary_text"
            android:textSize="@dimen/common_text_12" />

    </LinearLayout>

    <ImageView
        android:id="@+id/iv_playing_indicator"
        android:layout_width="@dimen/chapter_item_icon_size"
        android:layout_height="@dimen/chapter_item_icon_size"
        android:layout_marginStart="@dimen/chapter_item_icon_margin_start"
        android:src="@drawable/ic_chapter_arrow_right"
        android:contentDescription="@null" />

</LinearLayout>
